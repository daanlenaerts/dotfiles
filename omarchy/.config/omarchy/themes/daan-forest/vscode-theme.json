      }
    },
    {
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#000000"
      }
    }
  ],
  "semanticTokenColors": {
    "newOperator": "#77607D",
    "stringLiteral": "#7A5C36",
    "customLiteral": "#6D633A",
    "numberLiteral": "#55734A"
  }
}
