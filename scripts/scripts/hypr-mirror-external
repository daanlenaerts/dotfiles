#!/bin/bash

# Mirror the laptop panel from the external display, keeping the external one as
# the real display. Omarchy's built-in Mirror Display goes the other way (the
# external mirrors the laptop), so a 3:2 panel mirrored onto a 16:9 TV pillarboxes
# the TV. This inverts it: the TV runs its native mode full-screen and the laptop
# shows the letterboxed copy.
#
# Deliberately reuses Omarchy's own toggle flag file rather than a new one, so
# Omarchy's lifecycle still applies: the Mirror Display menu entry turns this off,
# and `omarchy-hyprland-monitor-internal-mirror recover` clears it on unplug. Both
# only test whether the file exists, not what is in it. Toggling Mirror Display
# back *on* rewrites the file with the stock direction.

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"
MARKER="-- hypr-mirror-external"

# `checked` in the Omarchy menu runs this on every render, so it stays a plain
# file test: no compositor queries. -e guards the marker, which starts with the
# two dashes grep would otherwise read as options.
status() {
  [[ -f $TOGGLE_FLAG ]] && grep -qFe "$MARKER" "$TOGGLE_FLAG"
}

on() {
  local INTERNAL EXTERNAL
  INTERNAL=$(omarchy-hyprland-monitor-laptop)
  # The first active external monitor. Read from `monitors all` with an explicit
  # disabled filter, because whichever monitor is currently mirroring is absent
  # from plain `monitors`.
  EXTERNAL=$(hyprctl monitors all -j |
    jq -r '.[] | select(.disabled != true) | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

  if [[ -z $EXTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "No external monitor found to mirror from"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "No laptop monitor found to mirror onto"
    exit 1
  fi

  # A disabled panel cannot show the mirror.
  omarchy-hyprland-toggle $DISABLE_TOGGLE off

  mkdir -p "$(dirname "$TOGGLE_FLAG")"
  {
    printf '%s\n' "$MARKER"
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' \
      "$INTERNAL" "$EXTERNAL"
  } >"$TOGGLE_FLAG"

  omarchy-notification-send -g 󰍹 "Mirroring from $EXTERNAL onto $INTERNAL"
  hyprctl reload
}

off() {
  if [[ -f $TOGGLE_FLAG ]]; then
    omarchy-hyprland-toggle $TOGGLE off
    omarchy-notification-send -g 󰍹 "Extended mode restored"
  fi
}

toggle() {
  if status; then
    off
  else
    on
  fi
}

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  status) status ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|status}" >&2
    exit 1
    ;;
esac
